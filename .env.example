# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# Supabase — Project Settings > API in the Supabase dashboard.
# The anon key is safe to ship in the app ONLY because RLS is enabled on every
# table (see supabase/migrations). It is not a secret; the RLS policies are.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx  # newer projects issue sb_publishable_… in place of the legacy anon JWT

# Google Maps — needs Maps SDK for Android + Maps SDK for iOS enabled.
# Baked into the native build, so it requires a rebuild after changing.
# NOT prefixed EXPO_PUBLIC_ on purpose: it is read at build time, not runtime.
GOOGLE_MAPS_API_KEY=your-maps-key

# Phase 3 only — never goes in the app bundle. Set it as a Supabase Edge
# Function secret instead: supabase secrets set ANTHROPIC_API_KEY=...
# ANTHROPIC_API_KEY=
